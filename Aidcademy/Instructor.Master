<%@ Master Language="C#" AutoEventWireup="true" CodeBehind="Instructor.master.cs" Inherits="Aidcademy.Instructor" %>

<!DOCTYPE html>
<style>
    /* Forces Quill Videos to be beautiful 16:9 widescreen */
    .ql-video { width: 100%; height: 400px; border-radius: 8px; }
</style>
<html>
<head runat="server">
    <title><asp:ContentPlaceHolder ID="TitleContent" runat="server"></asp:ContentPlaceHolder></title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    <link href="Styles/aidcademy-theme.css" rel="stylesheet" type="text/css" />
    <link href="https://cdn.quilljs.com/1.3.6/quill.snow.css" rel="stylesheet" />
    <asp:ContentPlaceHolder ID="HeadContent" runat="server"></asp:ContentPlaceHolder>
</head>
<body class="bg-light">
    <form id="form1" runat="server">
        <nav class="navbar navbar-expand-lg bg-brand-red py-3 shadow-sm">
            <div class="container">
                <a class="navbar-brand text-white fw-bold" href="#"><i class="fa-solid fa-truck-medical me-2"></i>AIDCADEMY</a>
                <div class="collapse navbar-collapse justify-content-end">
                    <ul class="navbar-nav align-items-center">
                        <li class="nav-item">
                            <a class='nav-link <%= Request.Url.AbsolutePath.Contains("InstructorManageContent") ? "fw-bold text-white" : "" %>' href="InstructorManageContent.aspx">
                                <i class="fa-solid fa-chart-line me-1"></i>Dashboard
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class='nav-link <%= Request.Url.AbsolutePath.Contains("InstructorUploadLesson") || Request.Url.AbsolutePath.Contains("InstructorEditContent") ? "fw-bold text-white" : "" %>' href="InstructorUploadLesson.aspx">
                                <i class="fa-solid fa-cloud-arrow-up me-1"></i>Upload Content
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class='nav-link <%= Request.Url.AbsolutePath.Contains("RespondQuestions") ? "fw-bold text-white" : "" %>' href="RespondQuestions.aspx">
                                <i class="fa-solid fa-comments me-1"></i>Q&A
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class='nav-link <%= Request.Url.AbsolutePath.Contains("InstructorProfile") ? "fw-bold text-white" : "" %>' href="InstructorProfile.aspx">
                                <i class="fa-solid fa-user-doctor me-1"></i>Profile
                            </a>
                        </li>
                        <li class="nav-item ms-3 d-flex align-items-center">
                            <asp:LinkButton ID="btnLogout" runat="server" CssClass="btn btn-outline-light btn-sm fw-bold px-4 rounded-pill" OnClick="btnLogout_Click" CausesValidation="false">
                                <i class="fa-solid fa-power-off me-1"></i> Logout
                            </asp:LinkButton>
                        </li>
                    </ul>
                </div>
            </div>
        </nav>
        <asp:ContentPlaceHolder ID="MainContent" runat="server"></asp:ContentPlaceHolder>

    </form>
    
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.quilljs.com/1.3.6/quill.js"></script>
    <asp:ContentPlaceHolder ID="ScriptContent" runat="server"></asp:ContentPlaceHolder>
</body>
</html>