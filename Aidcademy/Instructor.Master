<%@ Master Language="C#" AutoEventWireup="true" CodeBehind="Instructor.master.cs" Inherits="Aidcademy.Instructor" %>

<!DOCTYPE html>
<style>
    /* Forces Quill Videos to be beautiful 16:9 widescreen */
    .ql-video { width: 100%; height: 400px; border-radius: 8px; }
</style>
<html>
<head runat="server">
    <title><asp:ContentPlaceHolder ID="TitleContent" runat="server"></asp:ContentPlaceHolder></title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    <link href="Styles/aidcademy-theme.css" rel="stylesheet" type="text/css" />
    <link href="Styles/Instructor.css" rel="stylesheet" type="text/css" />
    <link href="https://cdn.quilljs.com/1.3.6/quill.snow.css" rel="stylesheet" />
    <asp:ContentPlaceHolder ID="HeadContent" runat="server"></asp:ContentPlaceHolder>
</head>
<body>
    <form id="form1" runat="server">
        <nav class="navbar navbar-expand-lg bg-brand-red py-3 shadow-sm">
            <div class="container">
                <a class="navbar-brand text-white fw-bold" href="MainPage.aspx"><i class="fa-solid fa-truck-medical me-2"></i>AIDCADEMY</a>
                <div class="collapse navbar-collapse justify-content-end">
                    <ul class="navbar-nav align-items-center">
                        <li class="nav-item">
                            <a class='nav-link <%= Request.Url.AbsolutePath.Contains("InstructorManageContent") ? "fw-bold text-white" : "" %>' href="InstructorManageContent.aspx">
                                <i class="fa-solid fa-chart-line me-1"></i>Dashboard
                            </a>
                        </li>
                        <li class="nav-item dropdown">
                            <a class='nav-link dropdown-toggle <%= Request.Url.AbsolutePath.Contains("InstructorUpload") || Request.Url.AbsolutePath.Contains("InstructorEditContent") ? "fw-bold text-white" : "" %>' href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                <i class="fa-solid fa-cloud-arrow-up me-1"></i>Upload
                            </a>
                            <ul class="dropdown-menu border-0 shadow mt-2" style="border-radius: 8px;">
                                <li><a class="dropdown-item fw-bold text-dark py-2" href="InstructorUploadLesson.aspx"><i class="fa-solid fa-file-lines text-danger me-2"></i>Upload Lesson</a></li>
                                <li><a class="dropdown-item fw-bold text-dark py-2" href="InstructorUploadQuiz.aspx"><i class="fa-solid fa-clipboard-question text-warning me-2"></i>Upload Quiz</a></li>
                            </ul>
                        </li>
                        <li class="nav-item">
                            <a class='nav-link <%= Request.Url.AbsolutePath.Contains("RespondQuestions") ? "fw-bold text-white" : "" %>' href="RespondQuestions.aspx">
                                <i class="fa-solid fa-comments me-1"></i>Q&A
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class='nav-link <%= Request.Url.AbsolutePath.Contains("InstructorProfile") ? "fw-bold text-white" : "" %>' href="InstructorProfile.aspx">
                                <i class="fa-solid fa-user-doctor me-1"></i>Profile
                            </a>
                        </li>
                        <li class="nav-item ms-3 d-flex align-items-center">
                            <asp:LinkButton ID="btnLogout" runat="server" CssClass="btn btn-outline-light btn-sm fw-bold px-4 rounded-pill" OnClick="btnLogout_Click" CausesValidation="false">
                                <i class="fa-solid fa-power-off me-1"></i> Logout
                            </asp:LinkButton>
                        </li>
                    </ul>
                </div>
            </div>
        </nav>
        <asp:ContentPlaceHolder ID="MainContent" runat="server"></asp:ContentPlaceHolder>
        <div class="modal fade" id="flipCardModal" tabindex="-1">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header bg-danger text-white">
                    <h5 class="modal-title"><i class="fa-solid fa-cube me-2"></i>Insert Flip Card</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" id="closeFlipModalBtn"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label text-muted small fw-bold">Image URL (Optional)</label>
                        <input type="text" id="fcImageUrl" class="form-control" placeholder="Paste an image URL..." />
                    </div>
                    <div class="mb-3">
                        <label class="form-label text-muted small fw-bold">Front Text (Title)</label>
                        <input type="text" id="fcFront" class="form-control" placeholder="e.g., R.I.C.E. Method" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label text-muted small fw-bold">Back Text (Explanation)</label>
                        <textarea id="fcBack" class="form-control" rows="3"></textarea>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="button" class="btn btn-danger" onclick="insertFlipCard()">Insert into Lesson</button>
                </div>
            </div>
        </div>
    </div>
        <div class="modal fade" id="accordionModal" tabindex="-1">
            <div class="modal-dialog">
                <div class="modal-content">
                    <div class="modal-header bg-dark text-white">
                        <h5 class="modal-title"><i class="fa-solid fa-list-ul me-2"></i>Insert Accordion</h5>
                        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" id="closeAccModalBtn"></button>
                    </div>
                    <div class="modal-body">
                        <div class="mb-3">
                            <label class="form-label text-muted small fw-bold">Accordion Title</label>
                            <input type="text" id="accTitle" class="form-control" />
                        </div>
                        <div class="mb-3">
                            <label class="form-label text-muted small fw-bold">Hidden Content</label>
                            <textarea id="accContent" class="form-control" rows="4"></textarea>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                        <button type="button" class="btn btn-dark" onclick="insertAccordion()">Insert Accordion</button>
                    </div>
                </div>
            </div>
        </div>
    </form>
    
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.quilljs.com/1.3.6/quill.js"></script>
    <asp:ContentPlaceHolder ID="ScriptContent" runat="server"></asp:ContentPlaceHolder>
</body>
</html>