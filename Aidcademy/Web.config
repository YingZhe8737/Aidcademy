<?xml version="1.0" encoding="utf-8"?>
<!--
  For more information on how to configure your ASP.NET application, please visit
  https://go.microsoft.com/fwlink/?LinkId=169433
  -->
<configuration>
  <system.web>
    <compilation debug="true" targetFramework="4.7.2" />
    <httpRuntime targetFramework="4.7.2" maxRequestLength="10240" />
    <!-- 10MB -->
    <pages>
      <namespaces>
        <add namespace="System.Web.Optimization" />
      </namespaces>
      <controls>
        <add assembly="Microsoft.AspNet.Web.Optimization.WebForms" namespace="Microsoft.AspNet.Web.Optimization.WebForms" tagPrefix="webopt" />
      </controls>
    </pages>
    <!-- Session configuration -->
    <sessionState mode="InProc" timeout="30" />
    <!-- Custom error pages -->
    <customErrors mode="Off" />
    <!-- Forms Authentication -->
    <authentication mode="Forms">
      <forms loginUrl="~/Login_signup.aspx" timeout="30" slidingExpiration="true" defaultUrl="~/MemberDashboard.aspx" />
    </authentication>
    

  </system.web>
	
  <runtime>
    <assemblyBinding xmlns="urn:schemas-microsoft-com:asm.v1">
      <dependentAssembly>
        <assemblyIdentity name="Antlr3.Runtime" publicKeyToken="eb42632606e9261f" />
        <bindingRedirect oldVersion="0.0.0.0-3.5.0.2" newVersion="3.5.0.2" />
      </dependentAssembly>
      <dependentAssembly>
        <assemblyIdentity name="Microsoft.Web.Infrastructure" publicKeyToken="31bf3856ad364e35" />
        <bindingRedirect oldVersion="0.0.0.0-2.0.0.0" newVersion="2.0.0.0" />
      </dependentAssembly>
      <dependentAssembly>
        <assemblyIdentity name="Newtonsoft.Json" publicKeyToken="30ad4fe6b2a6aeed" />
        <bindingRedirect oldVersion="0.0.0.0-13.0.0.0" newVersion="13.0.0.0" />
      </dependentAssembly>
      <dependentAssembly>
        <assemblyIdentity name="WebGrease" publicKeyToken="31bf3856ad364e35" />
        <bindingRedirect oldVersion="0.0.0.0-1.6.5135.21930" newVersion="1.6.5135.21930" />
      </dependentAssembly>
    </assemblyBinding>
  </runtime>
  <connectionStrings>
    <add name="AidcademyDB" connectionString="Data Source=(LocalDB)\MSSQLLocalDB;AttachDbFilename=|DataDirectory|\AidcademyDB.mdf;Integrated Security=True" providerName="System.Data.SqlClient" />
  </connectionStrings>
  <appSettings>
    <!-- OTP secret key -->
    <add key="OtpSecret" value="AidcademySecretKey2026" />
    <!-- Session timeout in minutes -->
    <add key="SessionTimeout" value="30" />
    <!-- OTP expiry in minutes -->
    <add key="OtpExpiryMinutes" value="10" />
    <!-- TEMP: Set true to skip OTP during login/signup. Set back to false to restore OTP verification. -->
    <add key="SkipOtpVerification" value="false" />
    <!-- Email configuration for OTP and password reset -->
    <add key="SmtpServer" value="smtp.gmail.com" />
    <add key="SmtpPort" value="587" />
    <add key="SmtpUsername" value="t3stf0r4pu@gmail.com" />
    <add key="SmtpPassword" value="mbyp drph zuvl migx" />
    <add key="SmtpEnableSSL" value="true" />
    <add key="EmailFrom" value="noreply@aidcademy.com" />
    <!-- File upload settings -->
    <add key="MaxFileSize" value="5242880" />
    <!-- 5MB in bytes -->
    <add key="ProfilePhotoPath" value="~/Uploads/ProfilePhotos/" />
    <!-- Google OAuth 2.0 (replace with your real credentials from Google Cloud Console) -->
    <add key="GoogleClientId" value="192250682334-rd7b1skl3qhbs8podc8efpenfglg726v.apps.googleusercontent.com" />
    <add key="GoogleClientSecret" value="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" />
    <add key="GoogleRedirectUri" value="https://localhost:44327/GoogleCallback.aspx" />
  </appSettings>
  <system.webServer>
    <defaultDocument>
      <files>
        <clear />
        <add value="MainPage.aspx" />
      </files>
    </defaultDocument>
    <security>
      <requestFiltering>
        <requestLimits maxAllowedContentLength="10485760" />
        <!-- 10MB -->
      </requestFiltering>
    </security>
    <modules>
      <!-- Remove Windows Auth + File Auth managed modules that interfere with Forms Authentication -->
      <remove name="WindowsAuthentication" />
      <remove name="FileAuthorization" />
    </modules>
  </system.webServer>
	<location path="MainPage.aspx">
		<system.web>
			<authorization>
				<allow users="?" />
			</authorization>
		</system.web>
	</location>
  <location path="Login_signup.aspx">
    <system.web>
      <authorization>
        <allow users="*" />
      </authorization>
    </system.web>
  </location>
  <location path="Login_signup">
    <system.web>
      <authorization>
        <allow users="*" />
      </authorization>
    </system.web>
  </location>
  <location path="ForgotPassword.aspx">
    <system.web>
      <authorization>
        <allow users="*" />
      </authorization>
    </system.web>
  </location>
  <location path="ForgotPassword">
    <system.web>
      <authorization>
        <allow users="*" />
      </authorization>
    </system.web>
  </location>
  <location path="VerifyOtp.aspx">
