<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <connectionStrings>
    <add name="AidcademyDB"
         connectionString="Data Source=(LocalDB)\MSSQLLocalDB;AttachDbFilename=|DataDirectory|\AidcademyDB.mdf;Integrated Security=True"
         providerName="System.Data.SqlClient" />
  </connectionStrings>

  <appSettings>
    <!-- Session timeout in minutes -->
    <add key="SessionTimeout" value="30" />

    <!-- OTP expiry in minutes -->
    <add key="OtpExpiryMinutes" value="10" />

    <!-- Email configuration for OTP and password reset -->
    <add key="SmtpServer" value="smtp.gmail.com" />
    <add key="SmtpPort" value="587" />
    <add key="SmtpUsername" value="your-email@gmail.com" />
    <add key="SmtpPassword" value="your-app-password" />
    <add key="SmtpEnableSSL" value="true" />
    <add key="EmailFrom" value="noreply@aidcademy.com" />

    <!-- File upload settings -->
    <add key="MaxFileSize" value="5242880" /> <!-- 5MB in bytes -->
    <add key="ProfilePhotoPath" value="~/Uploads/ProfilePhotos/" />
  </appSettings>

  <system.web>
    <compilation debug="true" targetFramework="4.7.2" />
    <httpRuntime targetFramework="4.7.2" maxRequestLength="10240" /> <!-- 10MB -->

    <!-- Session configuration -->
    <sessionState mode="InProc" timeout="30" />

    <!-- Custom error pages -->
    <customErrors mode="Off" />

    <!-- Forms Authentication -->
    <authentication mode="Forms">
      <forms loginUrl="~/Login_signup.aspx" timeout="30" slidingExpiration="true" />
    </authentication>

    <!-- Default: deny all anonymous users. Public pages are opened via <location> below. -->
    <authorization>
      <deny users="?" />
    </authorization>
  </system.web>

  <system.webServer>
    <defaultDocument>
      <files>
        <clear />
        <add value="Login_signup.aspx" />
      </files>
    </defaultDocument>
    <security>
      <requestFiltering>
        <requestLimits maxAllowedContentLength="10485760" /> <!-- 10MB -->
      </requestFiltering>
    </security>
  </system.webServer>

  <!-- ===== Public pages — allow anonymous ===== -->
  <location path="Login_signup.aspx">
    <system.web>
      <authorization>
        <allow users="*" />
      </authorization>
    </system.web>
  </location>

  <location path="ForgotPassword.aspx">
    <system.web>
      <authorization>
        <allow users="*" />
      </authorization>
    </system.web>
  </location>

  <location path="VerifyOtp.aspx">
    <system.web>
      <authorization>
        <allow users="*" />
      </authorization>
    </system.web>
  </location>

  <!-- Static resources (images, scripts, CSS) -->
  <location path="images">
    <system.web>
      <authorization>
        <allow users="*" />
      </authorization>
    </system.web>
  </location>

  <location path="Scripts">
    <system.web>
      <authorization>
        <allow users="*" />
      </authorization>
    </system.web>
  </location>

  <location path="Content">
    <system.web>
      <authorization>
        <allow users="*" />
      </authorization>
    </system.web>
  </location>

</configuration>
